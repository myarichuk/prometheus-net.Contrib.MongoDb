{
  "title": "MongoDB Client (prometheus-net.Contrib.MongoDb)",
  "uid": "prometheus-net-mongodb",
  "tags": [
    "mongodb",
    "prometheus-net"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mongodb_client_command_duration_count, target_db)",
          "refId": "v"
        },
        "definition": "label_values(mongodb_client_command_duration_count, target_db)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "collection",
        "label": "Collection",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mongodb_client_command_duration_count{target_db=~\"$db\"}, target_collection)",
          "refId": "v"
        },
        "definition": "label_values(mongodb_client_command_duration_count{target_db=~\"$db\"}, target_collection)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mongodb_client_connection_creation_rate, cluster_id)",
          "refId": "v"
        },
        "definition": "label_values(mongodb_client_connection_creation_rate, cluster_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
